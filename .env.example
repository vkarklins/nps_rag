DB_HOST=<host>
DB_NAME=<db name>
DB_USER=postgres
DB_PASSWORD=<password>
DB_PORT=5432
OPENAI_API_KEY=<key>

# Langfuse tracing (optional: leave unset to run without it). Keys: Langfuse project ->
# Settings -> API Keys. LANGFUSE_BASE_URL is the Langfuse server, e.g. a local docker
# compose instance or https://cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
# Keeps development traces apart from production ones in Langfuse.
LANGFUSE_TRACING_ENVIRONMENT=development
